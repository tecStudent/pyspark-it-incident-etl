{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tecstudent.github.io/pyspark-it-incident-etl/schemas/daily_trends_index.schema.json",
  "title": "Índice particionado de tendências diárias",
  "description": "Catálogo das partições mensais usadas pelo dashboard para carregar tendências sob demanda.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "mock",
    "total_records",
    "total_size_bytes",
    "partition_count",
    "default_partition",
    "partitions"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "mock": {"type": "boolean"},
    "total_records": {"type": "integer", "minimum": 0},
    "total_size_bytes": {"type": "integer", "minimum": 0},
    "partition_count": {"type": "integer", "minimum": 0},
    "default_partition": {
      "oneOf": [
        {"$ref": "#/$defs/partitionKey"},
        {"type": "null"}
      ]
    },
    "partitions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/partitionEntry"}
    }
  },
  "$defs": {
    "partitionKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["year", "month"],
      "properties": {
        "year": {"type": "integer", "minimum": 2000, "maximum": 2100},
        "month": {"type": "integer", "minimum": 1, "maximum": 12}
      }
    },
    "partitionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "year",
        "month",
        "path",
        "record_count",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "year": {"type": "integer", "minimum": 2000, "maximum": 2100},
        "month": {"type": "integer", "minimum": 1, "maximum": 12},
        "path": {
          "type": "string",
          "pattern": "^daily_trends/[0-9]{4}/(0[1-9]|1[0-2])\\.json$"
        },
        "record_count": {"type": "integer", "minimum": 0},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
